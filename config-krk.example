# ============================================================
#  DNS — węzeł Kraków (krk)
#  Lokalizacja: Kraków
#  Rola: strefa krk.mkw. (autorytatywna)
#        forward mkw. / hub.mkw. → hub VPN
#        forward bb.mkw.         → Bielsko (bezpośrednio, bez przechodzenia przez hub)
#
#  Interfejsy:
#    192.168.10.2  — koniec tunelu do centrum (tun-hub)
#    192.168.16.16 — adres LAN serwera DNS
#
#  Uruchomienie:
#    cp config-krk.example config.yaml
#    sudo python3 -m dns_server -c config.yaml
# ============================================================

server:
  id: "ns-krk"
  listen: "0.0.0.0"
  port: 53
  tcp: true
  udp: true

peers: []
peer_listen:
  host: "0.0.0.0"
  port: 5353

# Ogólny forwarder dla internetu — przez hub
forwarders:
  - "192.168.10.1"      # hub end of krk tunnel
  - "8.8.8.8"           # fallback bezpośredni

# ── Conditional forwarding ───────────────────────────────────────────────────
forward_zones:
  "mkw.":
    - "192.168.10.1"    # hub (strefa root)
  "hub.mkw.":
    - "192.168.10.1"    # hub
  "bb.mkw.":
    - "192.168.32.16"   # ns0.bb.mkw bezpośrednio przez VPN
    - "192.168.10.5"    # fallback: hub end of bb tunnel
  "10.168.192.in-addr.arpa.":
    - "192.168.10.1"    # reverse VPN → hub
  "32.168.192.in-addr.arpa.":
    - "192.168.32.16"   # reverse Bielsko → ns0.bb.mkw

cache:
  enabled: true
  max_size: 5000
  min_ttl: 30

state_file: "state-krk.yaml"

# ── ACL ──────────────────────────────────────────────────────────────────────
acl:
  - name: "localhost"
    match: ["127.0.0.0/8", "::1/128"]
    allow: ["read", "write", "peer"]

  - name: "lan-krakow"
    match: ["192.168.16.0/24"]
    allow: ["read"]

  - name: "vpn-hub"                  # hub może odpytywać Kraków (forward_zones)
    match: ["192.168.10.0/30"]       # 192.168.10.0–3 (tunel krk)
    allow: ["read"]

  - name: "default"
    match: ["0.0.0.0/0", "::/0"]
    allow: []

# ── Strefy lokalne (autorytatywne w Krakowie) ─────────────────────────────────
zones:

  # ════════════════════════════════════════════════════════════
  #  krk.mkw.  — strefa Kraków
  #  LAN: 192.168.16.0/24  |  DHCP: .100–.150
  # ════════════════════════════════════════════════════════════
  - name: "krk.mkw"
    records:

      - name: "@"
        type: SOA
        ttl: 3600
        mname:   "ns0.krk.mkw"
        rname:   "admin.mkw"
        serial:  2024010101
        refresh: 3600
        retry:   900
        expire:  604800
        minimum: 300

      - name: "@"
        type: NS
        ttl: 3600
        value: "ns0.krk.mkw"

      # ── Interfejs tunelowy ────────────────────────────────
      - name: "tun-hub"
        type: A
        ttl: 3600
        value: "192.168.10.2"

      - name: "to-hub"              # alias oryginalny
        type: CNAME
        ttl: 3600
        value: "tun-hub.krk.mkw"

      # ── Infrastruktura LAN ────────────────────────────────
      - name: "gw0"
        type: A
        ttl: 3600
        value: "192.168.16.1"

      - name: "sw0"
        type: A
        ttl: 3600
        value: "192.168.16.2"

      - name: "prn0"
        type: A
        ttl: 3600
        value: "192.168.16.3"

      - name: "nas0"
        type: A
        ttl: 3600
        value: "192.168.16.4"

      - name: "dsk0"
        type: A
        ttl: 3600
        value: "192.168.16.5"

      - name: "wifi-ext0"
        type: A
        ttl: 3600
        value: "192.168.16.8"

      - name: "ns0"
        type: A
        ttl: 3600
        value: "192.168.16.16"

      # ── Aliasy wygodne (bez cyfry) ────────────────────────
      - name: "gw"
        type: CNAME
        ttl: 3600
        value: "gw0.krk.mkw"

      - name: "ns"
        type: CNAME
        ttl: 3600
        value: "ns0.krk.mkw"

      - name: "nas"
        type: CNAME
        ttl: 3600
        value: "nas0.krk.mkw"

      - name: "prn"
        type: CNAME
        ttl: 3600
        value: "prn0.krk.mkw"


  # ════════════════════════════════════════════════════════════
  #  16.168.192.in-addr.arpa  — reverse LAN Kraków
  # ════════════════════════════════════════════════════════════
  - name: "16.168.192.in-addr.arpa"
    records:

      - name: "@"
        type: SOA
        ttl: 3600
        mname:   "ns0.krk.mkw"
        rname:   "admin.mkw"
        serial:  2024010101
        refresh: 3600
        retry:   900
        expire:  604800
        minimum: 300

      - name: "@"
        type: NS
        ttl: 3600
        value: "ns0.krk.mkw"

      - name: "1"
        type: PTR
        ttl: 3600
        value: "gw0.krk.mkw"

      - name: "2"
        type: PTR
        ttl: 3600
        value: "sw0.krk.mkw"

      - name: "3"
        type: PTR
        ttl: 3600
        value: "prn0.krk.mkw"

      - name: "4"
        type: PTR
        ttl: 3600
        value: "nas0.krk.mkw"

      - name: "5"
        type: PTR
        ttl: 3600
        value: "dsk0.krk.mkw"

      - name: "8"
        type: PTR
        ttl: 3600
        value: "wifi-ext0.krk.mkw"

      - name: "16"
        type: PTR
        ttl: 3600
        value: "ns0.krk.mkw"

logging:
  level: "INFO"
  file: ""
